{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TodoDoneYet Task File",
  "description": "JSON Schema for the TodoDoneYet Task File Format (.tddy).",
  "type": "object",
  "required": [
    "header",
    "title",
    "urgency",
    "mode"
  ],
  "properties": {
    "header": {
      "type": "string",
      "const": "TODODONEYET_TASK"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "urgency": {
      "type": "integer",
      "enum": [1, 2, 3, 4]
    },
    "mode": {
      "type": "string",
      "enum": [
        "SIMPLE_MODE",
        "DONE_YET",
        "RELENTLESS_MODE"
      ]
    },
    "activation": {
      "type": "integer",
      "minimum": 0
    },
    "anchor": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  },
  "additionalProperties": false
}
